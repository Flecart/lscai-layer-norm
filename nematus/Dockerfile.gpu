FROM nvcr.io/nvidia/tensorflow:24.02-tf2-py3

# Basic utilities and Nematus deps
RUN apt-get update && apt-get install -y \
    git \
    wget \
    cmake \
    vim \
    nano \
    libopenblas-dev \
    libxml2-dev \
    libxslt1-dev \
    # graphviz libraries are optional; uncomment if you really want pygraphviz later
    # graphviz \
    # libgraphviz-dev \
    && rm -rf /var/lib/apt/lists/*


# uv for venv + dependency management (same pattern as Nanochat)
RUN pip install --no-cache-dir uv

# Install mosesdecoder and subword-nmt inside the image
# (use stable paths so you can point vars to them)
RUN mkdir -p /opt && \
    git clone https://github.com/moses-smt/mosesdecoder.git /opt/mosesdecoder && \
    git clone https://github.com/rsennrich/subword-nmt.git /opt/subword-nmt

# Helpful env vars that your scripts/vars file can reuse
ENV moses_scripts=/opt/mosesdecoder/scripts
ENV subword_nmt_dir=/opt/subword-nmt


# Workdir (you’ll bind your $HOME/scratch/nematus into the container)
RUN mkdir -p /workspace
WORKDIR /workspace
